# ============================================================
# ComplxSimpleLearn - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ────────────────────────────────────────────────────────────
# CONVEX
# Get these from: https://dashboard.convex.dev
# Run `npx convex dev` first time to generate this.
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ────────────────────────────────────────────────────────────
# CLERK (Auth)
# Get these from: https://dashboard.clerk.com → API Keys
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Public site URL (used for Clerk invitation redirect links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────
# INVITE-ONLY SIGN UP (Clerk Dashboard — required)
# 1. Clerk Dashboard → Protect → Restrictions → Enable restricted mode
# 2. Copy CLERK_SECRET_KEY to Convex (invitations are sent from Convex actions):
#    npx convex env set CLERK_SECRET_KEY sk_test_...
#    npx convex env set SITE_URL https://your-production-domain.com  # or http://localhost:3000 for dev
# 3. Collect student names on sign-up:
#    Clerk Dashboard → User & authentication → User model
#    → enable First and last name → set to Required
# ────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────
# CONVEX + CLERK INTEGRATION
# From Clerk Dashboard → JWT Templates → "convex" template
# The "Issuer" field value (looks like https://xxx.clerk.accounts.dev)
# Set this in Convex dashboard too: Settings → Environment Variables
# ────────────────────────────────────────────────────────────
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ────────────────────────────────────────────────────────────
# EMAIL (Teacher → students)
# Set these on the CONVEX deployment (Settings → Environment Variables),
# not only in .env.local — sendEmail runs as a Convex action.
#
# Option A — Gmail (recommended for @gmail.com senders)
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Security → App passwords → Mail → create password (16 chars)
# 3. npx convex env set EMAIL_PROVIDER gmail
# 4. npx convex env set GMAIL_USER your@gmail.com
# 5. npx convex env set GMAIL_APP_PASSWORD xxxx xxxx xxxx xxxx
#    (spaces optional; use --prod for production)
# Optional display name: EMAIL_FROM_NAME=ComplxSimple
#
# Option B — Resend (custom domain)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=notifications@your-verified-domain.com
# ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=ComplxSimple

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev

# ────────────────────────────────────────────────────────────
# CLOUDFLARE TURNSTILE (Public info-session anti-spam)
# Create a widget: https://dash.cloudflare.com/?to=/:account/turnstile
# Set the public site key in Vercel/.env.local.
# Set TURNSTILE_SECRET_KEY on Convex (never expose it to the browser):
#   npx convex env set TURNSTILE_SECRET_KEY <secret>
#   npx convex env set TURNSTILE_SECRET_KEY <secret> --prod
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ────────────────────────────────────────────────────────────
# CLOUDFLARE R2 (Class video storage)
# Teachers upload full-length class recordings on the site; files are stored
# in Cloudflare R2 via the @convex-dev/r2 component (no upload size limit).
#
# These are set on the CONVEX deployment, NOT in this file:
#   npx convex env set R2_BUCKET            <bucket-name>
#   npx convex env set R2_ENDPOINT          <s3-api-endpoint>
#   npx convex env set R2_ACCESS_KEY_ID     <access-key-id>
#   npx convex env set R2_SECRET_ACCESS_KEY <secret-access-key>
#   npx convex env set R2_TOKEN             <token-value>
#
# Get these from: Cloudflare dashboard → R2 → create a bucket, then
# "Manage R2 API Tokens" → Create API Token (Object Read & Write).
# Also add a CORS policy on the bucket allowing GET + PUT from your app origin.
# ────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────
# TEACHER ROLE
# The email address that automatically gets "teacher" role.
# This should be Cassandra's email exactly as she'll sign up with.
# Also set this in Convex dashboard: Settings → Environment Variables
# ────────────────────────────────────────────────────────────
TEACHER_EMAIL=cassandra@example.com
