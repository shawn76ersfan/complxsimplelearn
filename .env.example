# ============================================================
# ComplxSimpleLearn - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ────────────────────────────────────────────────────────────
# CONVEX
# Get these from: https://dashboard.convex.dev
# Run `npx convex dev` first time to generate this.
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ────────────────────────────────────────────────────────────
# CLERK (Auth)
# Get these from: https://dashboard.clerk.com → API Keys
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ────────────────────────────────────────────────────────────
# CONVEX + CLERK INTEGRATION
# From Clerk Dashboard → JWT Templates → "convex" template
# The "Issuer" field value (looks like https://xxx.clerk.accounts.dev)
# Set this in Convex dashboard too: Settings → Environment Variables
# ────────────────────────────────────────────────────────────
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ────────────────────────────────────────────────────────────
# RESEND (Email)
# Get from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000/month
# ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for emails Cassandra sends.
# Must be a verified domain in Resend.
# For testing, use: onboarding@resend.dev (Resend's test address)
FROM_EMAIL=onboarding@resend.dev

# ────────────────────────────────────────────────────────────
# CLOUDFLARE R2 (Class video storage)
# Teachers upload full-length class recordings on the site; files are stored
# in Cloudflare R2 via the @convex-dev/r2 component (no upload size limit).
#
# These are set on the CONVEX deployment, NOT in this file:
#   npx convex env set R2_BUCKET            <bucket-name>
#   npx convex env set R2_ENDPOINT          <s3-api-endpoint>
#   npx convex env set R2_ACCESS_KEY_ID     <access-key-id>
#   npx convex env set R2_SECRET_ACCESS_KEY <secret-access-key>
#   npx convex env set R2_TOKEN             <token-value>
#
# Get these from: Cloudflare dashboard → R2 → create a bucket, then
# "Manage R2 API Tokens" → Create API Token (Object Read & Write).
# Also add a CORS policy on the bucket allowing GET + PUT from your app origin.
# ────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────
# TEACHER ROLE
# The email address that automatically gets "teacher" role.
# This should be Cassandra's email exactly as she'll sign up with.
# Also set this in Convex dashboard: Settings → Environment Variables
# ────────────────────────────────────────────────────────────
TEACHER_EMAIL=cassandra@example.com
